# One .env controls the complete CLI. Keep the real file private.
# WALLET_KEY selects single-wallet mode and WALLETS_FILE selects multi-wallet
# mode. When both exist, SPONSORED=true deliberately selects WALLETS_FILE.

# Telegram bot (`opensea-mint bot`). Create the token with @BotFather.
# ALLOWED_CHAT_IDS is a comma-separated list of numeric chat ids (find yours
# with @userinfobot). The bot refuses every other chat. Private keys never
# appear in chat — the bot uses WALLETS_FILE and accepts a wallets.json upload.
# BOT_TOKEN=123456:ABC-DEF...
# ALLOWED_CHAT_IDS=123456789
# Optional: comma-separated RPCs for the bot's snipes (else per-chain public
# nodes). RPC_URL is also read here.
# RPC_URL_BOT=https://base-mainnet.g.alchemy.com/v2/KEY

# Single-wallet mode (default example).
WALLET_KEY=0x<64-hex-character-private-key>

# Multi-wallet mode. Uncomment this complete section.
# Generate the manifest with: opensea-mint wallets create --count 10
# WALLETS_FILE=wallets.json
# SPONSORED=false
# RECIPIENT_ADDRESS=0x<40-hex-character-recipient-address>
# The recipient must never equal SPONSORED_EXECUTOR_ADDRESS.

# Required for `mint --fund`, sponsored minting, undelegation, and
# `deploy-executor`; otherwise optional in self-funded mode. Sponsored wallets
# hold their mint value and OpenSea action reserve while the sponsor pays actual
# transaction gas. It is the fallback recipient when RECIPIENT_ADDRESS is unset.
# SPONSOR_KEY=0x<64-hex-character-sponsor-private-key>

# Sponsored mode only. The RPC must pass EIP-7702 delegation and EIP-1153
# transient-storage probes, and executor code must match the audited runtime.
# Per-sponsor deterministic address printed by `deploy-executor`; identical across supported chains.
# SPONSORED_EXECUTOR_ADDRESS=0x<40-hex-character-executor-address>
# SPONSORED_OPERATION_DEADLINE_SECONDS=120

# Shared chain and mint settings for both wallet modes.
RPC_URL=https://your-chain-rpc.example
FEE_AUTOMATIC=true
GAS_LIMIT=300000

# Manual fee mode only: set FEE_AUTOMATIC=false and uncomment both values.
# MAX_FEE_PER_GAS_GWEI=1.5
# MAX_PRIORITY_FEE_PER_GAS_GWEI=0.1

# Long-running schedules refresh OpenSea phase metadata and eligibility every
# 10 minutes. Launch preparation starts at the compiled T-15/T-10 boundaries.
SCHEDULE_REFRESH_INTERVAL_SECONDS=600

# Same-nonce replacement and receipt tracking. Attempts: 1-10; pending timeout:
# 1-86400 seconds; polling delays: 50-60000 ms; fee factor: 10001-20000 bps.
TRANSACTION_MAX_ATTEMPTS=3
PENDING_TIMEOUT_SECONDS=20
RECEIPT_POLL_BASE_DELAY_MS=250
RECEIPT_POLL_MAX_DELAY_MS=2000
REPLACEMENT_BUMP_BPS=11250

# Request timeouts accept 100-120000 ms. Metadata, authentication, and
# eligibility use bounded fixed-interval retries.
# The T-2 calldata hot path retries transient or locally inconsistent actions
# at one fixed interval and never signs an action until local validation passes.
OPENSEA_REQUEST_TIMEOUT_MS=10000
ELIGIBILITY_REQUEST_TIMEOUT_MS=5000
OPENSEA_MAX_ATTEMPTS=3
OPENSEA_RETRY_INTERVAL_MS=250
OPENSEA_CALLDATA_MAX_ATTEMPTS=40
